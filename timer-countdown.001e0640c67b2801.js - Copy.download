function __parseTimeFromString(str){if(str.indexOf(':')!==-1){var parts=str.split(':');return[parseInt(parts[0],10)||0,parseInt(parts[1],10)||0,parts[2]?(parseInt(parts[2],10)||0):0]}else if(str.indexOf('hrs')!==-1){var cleaned=str.replace('hrs','').replace('mins','').replace('s','');var parts=cleaned.split(',').map(p=>parseInt(p,10)||0);return[parts[0]||0,parts[1]||0,parts[2]||0]}else{return-1}}
function __toTotalSeconds(hms){return(parseInt(hms[0]||0,10)*3600)+(parseInt(hms[1]||0,10)*60)+(parseInt(hms[2]||0,10))}
function __fromTotalSeconds(total){total=Math.max(0,total|0);var h=Math.floor(total/3600);var m=Math.floor((total%3600)/60);var s=total%60;return[h,m,s]}
function __formatHMS(hms){return hms[0]+' hrs, '+hms[1]+' mins, '+hms[2]+'s'}
function __displayNewTime(parsed,timerAreaElement){if(typeof parsed==='object'&&timerAreaElement){timerAreaElement.innerHTML=__formatHMS(parsed)}}
function __showTimerMessage(message,timerClassString){var timerAreaElement=document.getElementsByClassName(timerClassString)[0];timerAreaElement.innerHTML=message}
function __beginTimer(timerString,timerClassString,callback=!1){var callback=callback;window.__coderbyteTimerWarning=!1;if(!timerString||timerString===''){__showTimerMessage('Unlimited time',timerClassString);return}
var timerAreaElement=document.getElementsByClassName(timerClassString)[0];if(!timerAreaElement)return;var parsed=__parseTimeFromString(timerString);if(parsed===-1){__showTimerMessage('Invalid timer format',timerClassString);return}
if(parsed.length===2)parsed.push(0);window.__coderbyteRemainingSeconds=__toTotalSeconds(parsed);__displayNewTime(__fromTotalSeconds(window.__coderbyteRemainingSeconds),timerAreaElement);window.__coderbyteLatestTimeString=timerAreaElement.innerHTML;if(!window.__coderbyteTimerWebWorker){console.log('=== TIMER ===','new webworker setup',timerClassString);window.__coderbyteTimerWebWorker=new Worker('/static/js/shared/timer-webworker.js?v=withSeconds')}
console.log('=== TIMER ===','webworker onmessage setup');window.__coderbyteTimerWebWorker.onmessage=function(event){if(event.data&&event.data==='secondElapsed'){if(window.__coderbyteTimerWarning)return;if(!document.getElementsByClassName(timerClassString)[0]||timerAreaElement.innerHTML!==window.__coderbyteLatestTimeString){alert('Timer was modified incorrectly, please reload the page.');window.__coderbyteTimerWarning=!0;setTimeout(function(){window.location.reload()},1000);return}
window.__coderbyteRemainingSeconds-=1;if(window.__coderbyteRemainingSeconds<0){if(callback){return callback()}else{window.location.replace('/candidate-assessment?timeExpired=true')}}
var hms=__fromTotalSeconds(window.__coderbyteRemainingSeconds);__displayNewTime(hms,timerAreaElement);window.__coderbyteLatestTimeString=timerAreaElement.innerHTML}}}